package stb_image

use core { cptr, os, libc }
use runtime

#local {
    #object "stb_image.wasm" {
        stbi_load_from_memory :: (buffer: rawptr, len: i32, x, y, channels: &i32, desired: i32) -> [&] u8 ---
        stbi_image_free :: (data: [&] u8) -> void ---

        #provide { #namespace libc }
    }
}

#if runtime.platform.Supports_Files {
    load_image :: (path: str, desired_channels := 0) -> (pixels: [&] u8, x: i32, y: i32, channels: i32) {
        file_data := os.get_contents(path)
        defer delete(&file_data)

        pixels, x, y, channels = load_from_memory(file_data, desired_channels)
        return
    }
}

load_from_memory :: (buf: [] u8, desired_channels := 0) -> (pixels: [&] u8, x: i32, y: i32, channels: i32) {
    pixels = stbi_load_from_memory(buf.data, buf.length, &x, &y, &channels, desired_channels)
    return
}

free_image :: (data: rawptr) {
    stbi_image_free(data)
}

